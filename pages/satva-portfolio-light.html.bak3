          el.querySelector(".fd-front").setAttribute("aria-expanded", k === i);
        });
      }
      function close() { cur = -1; setActive(-1); wrap.removeAttribute("data-open"); }
      function open(i) {
        if (i === cur) { close(); return; }
        cur = i; setActive(i); pane.innerHTML = panel(P[i]);
        Array.prototype.forEach.call(pane.querySelectorAll("canvas.fd-art"), mount);
        document.getElementById("pdx").addEventListener("click", close);
        wrap.setAttribute("data-open", "");
        setTimeout(function () { wrap.scrollIntoView({ behavior: "smooth", block: "nearest" }); }, 120);
      }
      row.addEventListener("click", function (e) { var t = e.target.closest(".fd-front"); if (t) open(+t.closest(".fd").getAttribute("data-i")); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && cur > -1) close(); });

      // arrow buttons for mouse users; touch users swipe
      var pv = document.getElementById("fprev"), nx = document.getElementById("fnext"), nav = document.getElementById("worknav");
      function upd() {
        nav.hidden = row.scrollWidth <= row.clientWidth + 4;   // all projects fit → no arrows at all
        pv.disabled = row.scrollLeft < 4;
        nx.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
      }
      function by(d) {
        var step = row.firstElementChild.getBoundingClientRect().width + (parseFloat(getComputedStyle(row).columnGap) || 22);
        row.scrollBy({ left: d * step, behavior: "smooth" });
      }
      if (pv && nx) {
        pv.addEventListener("click", function () { by(-1); });
        nx.addEventListener("click", function () { by(1); });
        row.addEventListener("scroll", upd, { passive: true });
        window.addEventListener("resize", upd);
        upd();
      }
    })();
  </script>

  <!-- Halftone wordmark footer -->
  <script>
    (function () {
      var CFG = {
        wordmark: "satva.",
        dotGap: 6,          // distance between dot centres, CSS px
        radius: 80,         // how far the pointer pushes, CSS px
        crop: -0.08,          // how much of the cap height hangs below the bottom edge, -0.2 to 0.6
        grain: 0.5,         // print grain, 0 to 1
        interactive: true,
        fontFamily: '"Space Grotesk", "Inter", "Helvetica Neue", Arial, system-ui, sans-serif',
        fontWeight: 700
      };

      var root = document.getElementById("hwf-root");
      var canvas = document.getElementById("hwf-canvas");
      if (!root || !canvas) return;
      var ctx = canvas.getContext("2d");
      if (!ctx) return;

      // Colours come from the CSS variables on .hwf-root, so there is one source of truth.
      var cs = getComputedStyle(root);
      var COLORS = {
        background: cs.getPropertyValue("--hwf-bg").trim() || "#14171A",
        ink: cs.getPropertyValue("--hwf-ink").trim() || "#EDEAE0",
        warm: cs.getPropertyValue("--hwf-warm").trim() || "#7FBFA8"
      };

      document.getElementById("hwf-up").addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      // ---- pure helpers, identical to the original component ----
      function hwfHex(hex) {
        var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec((hex || "").trim());
        if (!m) return null;
        var h = m[1].length === 3 ? m[1].split("").map(function (c) { return c + c; }).join("") : m[1];
        return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
      }
      function hwfRadius(coverage, gap) {
        var c = coverage < 0 ? 0 : coverage > 1 ? 1 : coverage;
        return Math.sqrt(c) * gap * 0.56;
      }
      function hwfStep(x, y, vx, vy, hx, hy, px, py, r) {
        var dx = x - px, dy = y - py, d2 = dx * dx + dy * dy;
        if (r > 0 && d2 < r * r) {
          var d = Math.sqrt(d2) + 0.001;
          var f = (1 - d / r) * 2.6;
          vx += (dx / d) * f;
          vy += (dy / d) * f;
        }
        vx = (vx + (hx - x) * 0.05) * 0.84;
        vy = (vy + (hy - y) * 0.05) * 0.84;
        return [x + vx, y + vy, vx, vy];
      }
      function hwfWarmth(x, y, hx, hy, span) {
        var d = Math.hypot(x - hx, y - hy);
        return span > 0 ? Math.min(1, d / span) : 0;
      }
      function hwfFitSize(measured, width) {
        return measured > 0 ? (width / measured) * 100 : 0;
      }

      // ---- state ----
      var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var w = 0, h = 0, dpr = 1, px = -1e5, py = -1e5, raf = 0, visible = true, awake = true;
      var ring = { x: 0, y: 0, t: -1 };
      var dots = new Float32Array(0), count = 0, grainTile = null;
      var ink = hwfHex(COLORS.ink) || [237, 234, 224];
      var warm = hwfHex(COLORS.warm) || [127, 191, 168];

      function layout() {
        var rect = root.getBoundingClientRect();
        w = Math.max(1, Math.round(rect.width));
        h = Math.max(1, Math.round(rect.height));
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);

        // Set the word once, at a size that fills the width, on a 1x mask.
        var mask = document.createElement("canvas");
        mask.width = w; mask.height = h;
        var m = mask.getContext("2d", { willReadFrequently: true });
        if (!m) return;
        m.font = CFG.fontWeight + " 100px " + CFG.fontFamily;
        var word = CFG.wordmark || " ";
        var fit = hwfFitSize(m.measureText(word).width, w * 1.02);
        m.font = CFG.fontWeight + " " + fit + "px " + CFG.fontFamily;
        var box = m.measureText(word);
        var cap = box.actualBoundingBoxAscent || fit * 0.72;
        var c = Math.max(-0.2, Math.min(0.6, CFG.crop));
        m.fillStyle = "#000";
        m.textBaseline = "alphabetic";
        m.fillText(word, (w - box.width) / 2, h + cap * c);
        var img = m.getImageData(0, 0, w, h).data;

        var gap = Math.max(3, CFG.dotGap);
        var cols = Math.ceil(w / gap), rows = Math.ceil(h / gap);
        var tmp = [];
        for (var gy = 0; gy < rows; gy++) {
          for (var gx = 0; gx < cols; gx++) {
            var sum = 0;
            for (var sy = 0; sy < 3; sy++) {
              for (var sx = 0; sx < 3; sx++) {
                var x = Math.min(w - 1, Math.floor(gx * gap + ((sx + 0.5) * gap) / 3));
                var y = Math.min(h - 1, Math.floor(gy * gap + ((sy + 0.5) * gap) / 3));
                sum += img[(y * w + x) * 4 + 3];
              }
            }
            var cov = sum / (9 * 255);
            if (cov < 0.06) continue;
            var hx = gx * gap + gap / 2, hy = gy * gap + gap / 2;
            tmp.push(hx, hy, 0, 0, hx, hy, hwfRadius(cov, gap));
          }
        }
        dots = new Float32Array(tmp);
        count = tmp.length / 7;

        // A fixed tile of print grain, drawn once and laid over every frame.
        grainTile = document.createElement("canvas");
        grainTile.width = 256; grainTile.height = 256;
        var g = grainTile.getContext("2d");
        if (g) {
          var id = g.createImageData(256, 256);
          for (var i = 0; i < id.data.length; i += 4) {
            var v = Math.random() * 255;
            id.data[i] = id.data[i + 1] = id.data[i + 2] = v;
            id.data[i + 3] = Math.random() < 0.5 ? 0 : 255;
          }
          g.putImageData(id, 0, 0);
        }
        awake = true;
      }

      function draw(now) {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = COLORS.background;
        ctx.fillRect(0, 0, w, h);

        var r = CFG.interactive && !reduced ? Math.max(0, CFG.radius) : 0;
        var ringAge = ring.t < 0 ? 1e9 : now - ring.t;
        var ringR = ringAge * 0.9;
        var moving = false;

        for (var i = 0; i < count; i++) {
          var j = i * 7;
          var x = dots[j], y = dots[j + 1], vx = dots[j + 2], vy = dots[j + 3];
          var hx = dots[j + 4], hy = dots[j + 5];
          if (!reduced) {
            if (ringAge < 900) {
              var dx = hx - ring.x, dy = hy - ring.y;
              var d = Math.sqrt(dx * dx + dy * dy) + 0.001;
              var band = 1 - Math.min(1, Math.abs(d - ringR) / 26);
              if (band > 0) {
                var f = band * 3.2 * (1 - ringAge / 900);
                vx += (dx / d) * f;
                vy += (dy / d) * f;
              }
            }
            var s = hwfStep(x, y, vx, vy, hx, hy, px, py, r);
            x = s[0]; y = s[1]; vx = s[2]; vy = s[3];
            if (Math.abs(vx) + Math.abs(vy) > 0.02 || Math.abs(x - hx) + Math.abs(y - hy) > 0.05) moving = true;
            else { x = hx; y = hy; vx = 0; vy = 0; }
            dots[j] = x; dots[j + 1] = y; dots[j + 2] = vx; dots[j + 3] = vy;
          }
          var k = hwfWarmth(x, y, hx, hy, 28);
          ctx.fillStyle = k > 0.02
            ? "rgb(" + Math.round(ink[0] + (warm[0] - ink[0]) * k) + "," +
                       Math.round(ink[1] + (warm[1] - ink[1]) * k) + "," +
                       Math.round(ink[2] + (warm[2] - ink[2]) * k) + ")"
            : COLORS.ink;
          ctx.beginPath();
          ctx.arc(x, y, dots[j + 6], 0, 6.2832);
          ctx.fill();
        }

        if (grainTile && CFG.grain > 0) {
          ctx.globalAlpha = Math.min(1, CFG.grain) * 0.09;
          ctx.globalCompositeOperation = "overlay";
          var pattern = ctx.createPattern(grainTile, "repeat");
          if (pattern) { ctx.fillStyle = pattern; ctx.fillRect(0, 0, w, h); }
          ctx.globalAlpha = 1;
          ctx.globalCompositeOperation = "source-over";
        }
        // Sleep once everything is home and nothing is pushing.
        awake = moving || ringAge < 900 || px > -1e4;
      }

      function loop(now) {
        raf = 0;
        if (!visible) return;
        draw(now);
        if (awake) raf = requestAnimationFrame(loop);
      }
      function wake() {
        awake = true;
        if (!raf && visible) raf = requestAnimationFrame(loop);
      }

      function toLocal(e) {
        var b = canvas.getBoundingClientRect();
        return [e.clientX - b.left, e.clientY - b.top];
      }
      root.addEventListener("pointermove", function (e) {
        if (!CFG.interactive) return;
        var p = toLocal(e); px = p[0]; py = p[1]; wake();
      });
      root.addEventListener("pointerleave", function () {
        px = -1e5; py = -1e5; wake();
      });
      root.addEventListener("pointerdown", function (e) {
        if (!CFG.interactive || reduced) return;
        if (e.target.closest("a,button")) return;
        var p = toLocal(e);
        ring = { x: p[0], y: p[1], t: performance.now() };
        wake();
      });

      layout();
      draw(performance.now());
      wake();

      new ResizeObserver(function () { layout(); wake(); }).observe(root);
      new IntersectionObserver(function (entries) {
        visible = entries[0] ? entries[0].isIntersecting : true;
        if (visible) wake();
      }).observe(root);

      // Re-set the word once the real typeface has loaded.
      function relayout() { layout(); wake(); }
      if (document.fonts) {
        if (document.fonts.load) {
          document.fonts.load(CFG.fontWeight + " 100px 'Space Grotesk'", CFG.wordmark).then(relayout, function () {});
        }
        if (document.fonts.ready) document.fonts.ready.then(relayout);
      }
    })();
  </script>

<script>
(function () {
  var side = document.getElementById('sidemenu');
  var btn = document.getElementById('menubtn');
  var overlay = document.getElementById('sideoverlay');
  if (!side || !btn) return;

  // Build the text-roll: two stacked copies of each word, letter by letter, staggered from the centre.
  document.querySelectorAll('[data-roll]').forEach(function (el) {
    var t = el.textContent.trim(), n = t.length;
    function letters() {
      return t.split('').map(function (ch, i) {
        var d = (0.035 * Math.abs(i - (n - 1) / 2)).toFixed(3);
        return '<span style="--d:' + d + 's">' + (ch === ' ' ? '&nbsp;' : ch) + '</span>';
      }).join('');
    }
    el.innerHTML = '<span class="roll-a">' + letters() + '</span><span class="roll-b" aria-hidden="true">' + letters() + '</span>';
    var a = el.closest('a'); if (a) a.setAttribute('aria-label', t);
  });

  function set(open) {
    side.classList.toggle('open', open);
    side.setAttribute('aria-hidden', String(!open));
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }
  btn.addEventListener('click', function () { set(!side.classList.contains('open')); });
  overlay.addEventListener('click', function () { set(false); });
  side.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { set(false); }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
})();
</script>

<script>
(function () {
  var tl = document.getElementById('tl');
  if (!tl) return;
  var svg = document.getElementById('tlsvg'), path = document.getElementById('tlpath');
  var items = [].slice.call(tl.querySelectorAll('.tl-item')), NS = 'http://www.w3.org/2000/svg';
  var DUR = 1.3, HI = 26, LO = 82, H = 110, made = [];
  var delay = function (i) { return (i / (items.length - 1) * DUR).toFixed(2) + 's'; };
  items.forEach(function (el, i) { el.style.setProperty('--d', (i / (items.length - 1) * DUR + 0.1).toFixed(2) + 's'); });

  function build() {
    made.forEach(function (n) { n.remove(); }); made = [];
    if (getComputedStyle(svg).display === 'none') return;
    var r = tl.getBoundingClientRect();
    var pts = items.map(function (el, i) {
      var b = el.getBoundingClientRect();
      return { x: b.left - r.left + Math.min(96, b.width * 0.42), y: i % 2 ? LO : HI };
    });
    svg.setAttribute('width', r.width); svg.setAttribute('height', H); svg.setAttribute('viewBox', '0 0 ' + r.width + ' ' + H);
    var d = 'M' + pts[0].x + ' ' + pts[0].y;
    for (var i = 1; i < pts.length; i++) {
      var a = pts[i - 1], b = pts[i], m = (a.x + b.x) / 2;
      d += ' C' + m + ' ' + a.y + ' ' + m + ' ' + b.y + ' ' + b.x + ' ' + b.y;
    }
    path.setAttribute('d', d);
    var L = path.getTotalLength();
    path.style.strokeDasharray = L; path.style.setProperty('--L', L);
    pts.forEach(function (p, i) {
      var g = document.createElementNS(NS, 'g');
      g.setAttribute('transform', 'translate(' + p.x + ' ' + p.y + ')');
      g.setAttribute('class', 'tl-node' + (items[i].classList.contains('cur') ? ' cur' : '') + (items[i].classList.contains('up') ? ' up' : ''));
      g.style.setProperty('--d', delay(i));
      g.innerHTML = '<g class="tl-pop"><circle class="ring" r="17"></circle><circle class="dot" r="3.5"></circle></g>';
      svg.appendChild(g); made.push(g);
    });
  }

  var tick = 0;
  function rebuild() { cancelAnimationFrame(tick); tick = requestAnimationFrame(build); }
  build();
  new ResizeObserver(rebuild).observe(tl);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(rebuild);

  // play when it scrolls into view, reset when it leaves so it replays
  new IntersectionObserver(function (es) {
    var e = es[0];
    if (e.intersectionRatio >= 0.3) tl.classList.add('go');
    else if (e.intersectionRatio === 0) tl.classList.remove('go');
  }, { threshold: [0, 0.3] }).observe(tl);
})();
</script>
<script>
/* one wheel flick = one section (desktop). Touch and keyboard use CSS scroll-snap. */
(function () {
  var mq = matchMedia('(min-width: 861px) and (prefers-reduced-motion: no-preference)');
  var sel = '.hero2,#intro,#stack,#experience,#work,#beyond,.closing';
  var locked = false, last = 0, timer = 0, menu = document.getElementById('sidemenu');
  function pos() {
    var max = document.documentElement.scrollHeight - innerHeight, y = scrollY;
    var els = [].slice.call(document.querySelectorAll(sel)).map(function (e) {
      var r = e.getBoundingClientRect(); return { t: Math.min(Math.round(r.top + y), max), h: r.height };
    });
    var list = els.map(function (e) { return e.t; });
    if (max - list[list.length - 1] > 5) list.push(max);
    return { els: els, list: list };
  }
  addEventListener('wheel', function (e) {
    if (!mq.matches || e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY) || Math.abs(e.deltaY) < 2) return;
    if (menu && menu.classList.contains('open')) return;
    var now = performance.now(), dir = e.deltaY > 0 ? 1 : -1;
    if (locked) { e.preventDefault(); last = now; return; }
    var p = pos(), y = scrollY, to;
    for (var i = 0; i < p.els.length; i++) {               // section taller than the screen: scroll inside it normally
      var s = p.els[i];
      if (s.h > innerHeight + 8 && y >= s.t - 4 && y < s.t + s.h - 4) {
        if (dir > 0 && y + innerHeight < s.t + s.h - 8) return;
        if (dir < 0 && y > s.t + 8) return;
      }
    }
    if (dir > 0) { for (var a = 0; a < p.list.length; a++) if (p.list[a] > y + 4) { to = p.list[a]; break; } }
    else { for (var b = p.list.length - 1; b >= 0; b--) if (p.list[b] < y - 4) { to = p.list[b]; break; } }
    if (to === undefined) return;
    e.preventDefault(); locked = true; last = now;
    scrollTo({ top: to, behavior: 'smooth' });
    clearInterval(timer);
    timer = setInterval(function () {
      var t = performance.now();
      if ((t - last > 160 && Math.abs(scrollY - to) < 3) || t - last > 1500) { locked = false; clearInterval(timer); }
    }, 60);
  }, { passive: false });
})();
</script>

</body>

</html>
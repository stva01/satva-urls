<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satva Shah — Software Engineer</title>

  <!-- Open Graph / WhatsApp / social preview -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Satva Shah — Software Engineer">
  <meta property="og:description"
    content="Backend-leaning CS student building async systems, multi-agent pipelines, and the CI/CD behind them.">
  <meta property="og:image" content="og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <!-- Replace with your live URL once hosted, e.g. https://satva.dev -->
  <meta property="og:url" content="https://satva-urls-nine.vercel.app/">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Satva Shah — Software Engineer">
  <meta name="twitter:description"
    content="Backend-leaning CS student building async systems, multi-agent pipelines, and the CI/CD behind them.">
  <meta name="twitter:image" content="og-image.png">

  <meta name="theme-color" content="#2F5D50">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #F6F5F1;
      --ink: #171717;
      --muted: #6B6B63;
      --line: #DDDACC;
      --accent: #2F5D50;
      --accent-soft: #E4EBE7;
      --max: 700px;
      --pad: 24px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 80px;
      overflow-x: hidden;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -webkit-overflow-scrolling: touch;
      overflow-x: hidden;
    }

    /* Smooth scroll with custom easing */
    @media (prefers-reduced-motion: no-preference) {
      html {
        scroll-behavior: smooth;
      }
      * {
        scroll-behavior: smooth;
      }
    }

    ::selection {
      background: var(--accent);
      color: #fff;
    }

    a {
      color: inherit;
    }

    .wrap {
      position: relative;
      z-index: 1;
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--pad);
    }

    /* ---------- HERO ---------- */
    .hero {
      padding: 96px 0 72px;
    }

    .eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      color: var(--accent);
      letter-spacing: 0.06em;
      margin-bottom: 18px;
    }

    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      line-height: 1.08;
      letter-spacing: -0.01em;
      margin-bottom: 20px;
    }

    .lede {
      max-width: 52ch;
      color: #3a3a35;
      font-size: 1.08rem;
      margin-bottom: 34px;
    }

    .terminal {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13.5px;
      background: #14171A;
      color: #EDEAE0;
      border-radius: 6px;
      padding: 14px 18px;
      display: inline-flex;
      align-items: center;
      gap: 2px;
      max-width: 100%;
      overflow-x: auto;
      white-space: nowrap;
    }

    .terminal .prompt {
      color: #7FBFA8;
    }

    .terminal .cmd {
      color: #EDEAE0;
    }

    .cursor {
      display: inline-block;
      width: 7px;
      height: 15px;
      background: #7FBFA8;
      margin-left: 4px;
      animation: blink 1.1s steps(1) infinite;
      vertical-align: middle;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    .links {
      margin-top: 30px;
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
    }

    .links a {
      font-size: 14px;
      text-decoration: none;
      padding: 9px 16px;
      border: 1px solid var(--line);
      border-radius: 100px;
      transition: border-color .15s ease, background .15s ease;
    }

    .links a:hover {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    /* ---------- SECTIONS ---------- */
    section {
      position: relative;
      z-index: 1;
      padding: 56px 0;
      border-top: 1px solid var(--line);
    }

    section:first-of-type {
      border-top: none;
    }

    .label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12.5px;
      color: var(--muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 26px;
    }

    h2.title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.6rem;
      font-weight: 600;
      margin-bottom: 16px;
    }

    p.body-text {
      color: #3a3a35;
      max-width: 60ch;
    }

    /* ---------- EXPERIENCE ---------- */
    .entry {
      margin-bottom: 36px;
    }

    .entry:last-child {
      margin-bottom: 0;
    }

    .entry-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin-bottom: 8px;
    }

    .entry-role {
      font-weight: 600;
      font-size: 1.05rem;
    }

    .entry-meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12.5px;
      color: var(--muted);
    }

    .entry ul {
      list-style: none;
      margin-top: 10px;
    }

    .entry li {
      position: relative;
      padding-left: 18px;
      margin-bottom: 8px;
      color: #3a3a35;
      font-size: 0.96rem;
    }

    .entry li::before {
      content: "—";
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .phase-tag {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11.5px;
      color: var(--accent);
      background: var(--accent-soft);
      border-radius: 4px;
      padding: 2px 7px;
      margin-right: 8px;
    }

    /* ---------- PROJECTS ---------- */
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width:560px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    .card {
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 20px;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: border-color .15s ease, transform .15s ease;
    }

    .card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .card-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 1.05rem;
      margin-bottom: 6px;
    }

    .card-stack {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11.5px;
      color: var(--accent);
      margin-bottom: 10px;
      display: block;
    }

    .card-desc {
      font-size: 0.92rem;
      color: #4a4a44;
    }

    /* ---------- BEYOND ---------- */
    .beyond-grid {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .beyond-item {
      display: flex;
      gap: 16px;
    }

    .beyond-mark {
      font-family: 'IBM Plex Mono', monospace;
      color: var(--accent);
      font-size: 13px;
      padding-top: 3px;
      flex-shrink: 0;
    }

    .beyond-text b {
      font-weight: 600;
    }

    .beyond-text {
      font-size: 0.96rem;
      color: #3a3a35;
    }

    /* ---------- PROJECT FOLDERS ---------- */
    .fd-hint { display: none; font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--muted); margin: -14px 0 0; }
    @media (hover: none) { .fd-hint { display: block; } }
    .folders { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
      margin: 0 calc(var(--pad) * -1); padding: 34px var(--pad) 6px; scroll-padding: 0 var(--pad); scrollbar-width: none; }
    .folders::-webkit-scrollbar { display: none; }
    .fd { flex: 0 0 min(210px, 62vw); scroll-snap-align: start; }
    .fd-box { container-type: inline-size; position: relative; aspect-ratio: 1 / .86; }
    .fd-back { position: absolute; left: 0; right: 0; top: 9cqw; bottom: 0; border-radius: 3.6cqw; background: var(--tab, #E6E4DC); box-shadow: inset 0 0 0 1px rgba(23,23,23,.07); }
    .fd-back::before { content: ""; position: absolute; left: 0; top: -4.2cqw; width: 36cqw; height: 8cqw; border-radius: 3cqw 3cqw 0 0; background: var(--tab, #E6E4DC); box-shadow: inset 0 1px 0 rgba(23,23,23,.07); }
    .fd-sheet { position: absolute; left: 9cqw; right: 9cqw; top: 14cqw; height: 58cqw; border-radius: 2.6cqw; overflow: hidden; transform-origin: 50% 100%;
      box-shadow: 0 0 0 1px rgba(23,23,23,.1), 0 1.5cqw 3cqw -1cqw rgba(20,23,26,.3);
      transition: transform .6s cubic-bezier(.34, 1.36, .5, 1); }
    .fd-a { background: #14171A; transform: translateX(5cqw) rotate(2.5deg); }
    .fd-b { background: #fff; transform: translateX(-3cqw) rotate(-3deg); }
    .fd:hover .fd-a, .fd[data-active] .fd-a, .fd:focus-within .fd-a { transform: translate(6cqw, -10cqw) rotate(5deg); }
    .fd:hover .fd-b, .fd[data-active] .fd-b, .fd:focus-within .fd-b { transform: translate(-5cqw, -7cqw) rotate(-6deg); }
    .sh-bar { display: flex; gap: 1.3cqw; padding: 3cqw 3.4cqw; }
    .sh-bar i { width: 1.6cqw; height: 1.6cqw; border-radius: 50%; background: rgba(255,255,255,.28); }
    .fd-b .sh-bar i { background: rgba(23,23,23,.14); }
    .sh-l { display: block; height: 1.5cqw; margin: 2.2cqw 3.6cqw 0; border-radius: 1cqw; background: rgba(127,191,168,.7); }
    .sh-l.d { background: rgba(255,255,255,.14); }
    .fd-b .sh-l { background: rgba(23,23,23,.1); }
    .fd-b .sh-l.h { height: 2.6cqw; width: 46%; background: rgba(47,93,80,.55); margin-top: 1.4cqw; }
    .fd-front { all: unset; box-sizing: border-box; position: absolute; left: 0; right: 0; bottom: 0; top: 36cqw; z-index: 3; cursor: pointer;
      border-radius: 3.6cqw; padding: 0 5.5cqw 5cqw; display: flex; align-items: flex-end; justify-content: space-between; gap: 3cqw;
      background: linear-gradient(180deg, rgba(255,255,255,.26), rgba(246,245,241,.7));
      -webkit-backdrop-filter: blur(9px) saturate(1.3); backdrop-filter: blur(9px) saturate(1.3);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 0 0 1px rgba(23,23,23,.1), 0 2cqw 4cqw -1.5cqw rgba(20,23,26,.3);
      transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
    .fd-front:hover { transform: translateY(.8cqw); }
    .fd-front:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .fd-title { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 6.6cqw; line-height: 1.1; letter-spacing: -.01em; color: var(--ink); max-width: 56cqw; }
    .fd-key { flex: none; width: 12cqw; height: 12cqw; border-radius: 3cqw; display: grid; place-items: center; background: #14171A; color: #EDEAE0;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1cqw 2cqw -.8cqw rgba(0,0,0,.5); transition: transform .35s cubic-bezier(.34, 1.36, .5, 1); }
    .fd-key svg { width: 5.6cqw; height: 5.6cqw; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: rotate .4s ease; }
    .fd[data-active] .fd-key svg { rotate: 90deg; }
    .fd-cap { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-top: 12px; font-size: 11.5px; line-height: 1.4; color: var(--muted); }
    .fd-cap a, .fd-cap button { all: unset; cursor: pointer; flex: none; font-weight: 600; color: var(--ink); text-decoration: none; }
    .fd-cap a:hover, .fd-cap button:hover { text-decoration: underline; text-underline-offset: 3px; }
    .fd-cap a:focus-visible, .fd-cap button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .fd-art { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: inherit; object-fit: cover; opacity: 0; transition: opacity .9s ease; }
    .fd-art[data-ready] { opacity: 1; }
    .fd-a .sh-bar { position: relative; }
    .fd-a .sh-bar i { background: rgba(255,255,255,.7); }
    .work-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .work-head .label { margin-bottom: 0; }
    .work-nav { display: flex; gap: 8px; }
    .work-nav button { all: unset; box-sizing: border-box; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; cursor: pointer; font-size: 15px; color: var(--ink); transition: border-color .15s ease, background .15s ease, opacity .15s ease; }
    .work-nav button:hover:not(:disabled) { border-color: var(--accent); background: var(--accent-soft); }
    .work-nav button:disabled { opacity: .35; cursor: default; }
    .work-nav button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    @media (hover: none) { .work-nav { display: none; } }
    .pd-wrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .55s cubic-bezier(.2, .8, .2, 1); }
    .pd-wrap[data-open] { grid-template-rows: 1fr; }
    .pd-wrap > div { overflow: hidden; min-height: 0; }
    .pd { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--line); }
    .pd-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--muted); }
    .pd-x { all: unset; cursor: pointer; width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 8px; font-size: 16px; line-height: 1; color: var(--ink); }
    .pd-x:hover { background: var(--accent-soft); border-color: var(--accent); }
    .pd-x:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .pd-body { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 28px; padding-bottom: 8px; }
    @media (max-width: 560px) { .pd-body { grid-template-columns: 1fr; gap: 20px; } }
    .pd-vis { position: relative; overflow: hidden; align-self: start; padding: 22px; border-radius: 10px; background: var(--accent-soft); }
    .mock { position: relative; border-radius: 8px; background: #14171A; padding: 12px 14px 16px; color: #EDEAE0; box-shadow: 0 10px 24px -10px rgba(20,23,26,.5); }
    .mock .sh-bar { padding: 0 0 12px; }
    .mock b { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 600; margin-bottom: 12px; }
    .mrow { margin-bottom: 10px; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: rgba(237,234,224,.7); }
    .mrow em { display: block; height: 4px; margin-top: 5px; border-radius: 2px; background: #7FBFA8; }
    .pd-main h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.35rem; font-weight: 600; line-height: 1.15; }
    .pd-sub { font-size: 12.5px; color: var(--muted); margin-bottom: 14px; }
    .pd-sec { padding: 14px 0; border-top: 1px solid var(--line); }
    .pd-sec h4 { font-size: .9rem; font-weight: 600; margin-bottom: 8px; }
    .pd-sec p { font-size: .88rem; color: #4a4a44; }
    .pd-stack { margin-top: 10px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted); }
    .pd-links { margin-top: 12px; display: flex; gap: 14px; font-size: 12.5px; font-weight: 600; }
    .flow { list-style: none; counter-reset: s; }
    .flow li { position: relative; padding: 0 0 12px 30px; font-size: .86rem; color: #4a4a44; counter-increment: s; }
    .flow li::before { content: counter(s); position: absolute; left: 0; top: 1px; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
      font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--accent); background: var(--accent-soft); }
    .flow li:not(:last-child)::after { content: ""; position: absolute; left: 9.5px; top: 24px; bottom: 2px; width: 1px; background: var(--line); }
    .flow b { display: block; font-weight: 600; color: var(--ink); }
    .flow a { text-decoration: underline; text-underline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) { .fd *, .pd-wrap { transition: none !important; } }

    /* ---------- SELECTED WORK: wide section, 4-up, reference-style header ---------- */
    #experience { border-bottom: 1px solid var(--line); }

    /* break this one section out of the 700px column; the rest of the page stays narrow */
    #work, #stack {
      --W: min(1120px, calc(100vw - 2 * var(--pad)));
      width: var(--W);
      margin-left: calc(50% - var(--W) / 2);
      border-top: 0;
      padding-top: 64px;
    }

    #work .label, #stack .label { margin-bottom: 18px; }

    .work-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
    .work-title, .stack-title {
      font-family: 'Space Grotesk', sans-serif; font-weight: 600;
      font-size: clamp(2.8rem, 6.4vw, 4.6rem); line-height: .96; letter-spacing: -.035em;
    }
    .gh-link {
      display: inline-flex; align-items: center; gap: 10px; margin-top: 14px;
      font-size: 13px; text-decoration: none; color: var(--ink);
    }
    .gh-link i {
      font-style: normal; width: 28px; height: 28px; display: grid; place-items: center;
      border: 1px solid var(--line); border-radius: 8px; font-size: 14px;
      transition: background .15s ease, border-color .15s ease;
    }
    .gh-link:hover i { background: var(--accent-soft); border-color: var(--accent); }

    .work-sub { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin: 28px 0 8px; }
    .work-sub .body-text { max-width: 46ch; font-size: 1.02rem; }
    .work-nav[hidden] { display: none; }

    /* exactly N folders per page, no peeking sliver, edges line up with everything else */
    .folders {
      --n: 4; --fg: 22px;
      display: grid; grid-auto-flow: column;
      grid-auto-columns: calc((100% - (var(--n) - 1) * var(--fg)) / var(--n));
      gap: var(--fg);
      margin: 0; padding: 44px 0 8px; scroll-padding: 0;
    }
    .fd { min-width: 0; flex: none; }
    @media (max-width: 1000px) { .folders { --n: 3; } }
    @media (max-width: 720px)  { .folders { --n: 2; --fg: 16px; } }
    @media (max-width: 480px)  { .folders { --n: 1.6; } }

    /* folder face: smaller frosted panel, bigger title, so it isn't a big empty slab */
    .fd-front { top: 44cqw; padding: 0 6cqw 5.5cqw;
      background: linear-gradient(180deg, rgba(255,255,255,.34), rgba(246,245,241,.82)); }
    .fd-title { font-size: 8.2cqw; max-width: 62cqw; line-height: 1.05; letter-spacing: -.02em; }
    .fd-key { width: 13cqw; height: 13cqw; }
    .fd-cap { font-size: 12.5px; margin-top: 14px; }

    /* details pane: a bit more room now that the container is wider */
    .pd-body { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 40px; }
    .pd-vis { padding: 32px; }
    @media (max-width: 560px) { .pd-body { grid-template-columns: 1fr; gap: 20px; } }

    /* ---------- TECH STACK: staggered columns + chips ---------- */
    .stack-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
    .stack-title { margin: 0; }
    .stack-note { font-size: 13px; color: var(--muted); max-width: 14ch; margin-top: 16px; line-height: 1.45; }
    .stack-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px; margin-top: 56px; align-items: start; }
    .stack-col { border-top: 1px solid var(--ink); padding-top: 22px; }
    .stack-col:nth-child(2) { margin-top: 40px; }
    .stack-col:nth-child(3) { margin-top: 80px; }
    .stack-col h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(1.5rem, 2.4vw, 1.95rem);
      line-height: 1.08; letter-spacing: -.02em; max-width: 12ch; }
    .stack-col p { font-family: 'Space Grotesk', sans-serif; font-size: 12px; color: var(--muted); max-width: 30ch; margin: 14px 0 22px; line-height: 1.5; }
    .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 14px; line-height: 1; padding: 11px 13px; border-radius: 3px;
      background: #E9E7E0; color: var(--ink); box-shadow: inset 0 0 0 1px rgba(23,23,23,.05); cursor: default;
      transition: background .2s ease, color .2s ease; }
    .chip:hover, .chip.on:hover { background: var(--accent); color: #fff; box-shadow: none; }
    .chip.on { background: #14171A; color: #F6F5F1; box-shadow: none; }
    @media (max-width: 860px) {
      .stack-cols { grid-template-columns: 1fr; gap: 36px; margin-top: 36px; }
      .stack-col:nth-child(n) { margin-top: 0; }
    }

    /* ---------- GLOBAL GLYPH BACKGROUND ---------- */
    #glyph { 
      position: fixed; 
      top: 0;
      left: 0;
      width: 100vw; 
      height: 100vh;
      z-index: 0; 
      pointer-events: none;
    }

    /* ---------- HERO: glyph background + headline + crowd ---------- */
    .hero2 { position: relative; height: calc(100vh - 57px); height: calc(100svh - 57px); min-height: 640px; padding: 0; border: 0;
      overflow: hidden; isolation: isolate; --Z: min(52vh, 480px); }
    .hero-copy { position: absolute; z-index: 1; top: clamp(24px, 6vh, 72px); left: 0; right: 0; padding: 0 var(--pad); text-align: center; pointer-events: none; }
    .hero-copy h1 { margin: 0; font-size: clamp(2.6rem, min(10.5vw, 15.5vh), 8.5rem); line-height: .9; letter-spacing: -.045em; text-transform: uppercase; }
    .hero-copy .l1, .hero-copy .l2 { display: block; clip-path: inset(-40% -20% 0 -20%); }
    .hero-copy .ch { display: inline-block; }
    @media (prefers-reduced-motion: no-preference) {
      .hero-copy.go .ch { animation: pop .95s cubic-bezier(.22,.9,.28,1) both; animation-delay: calc(var(--i) * 34ms + 120ms); transform-origin: 30% 100%; }
      .hero-copy.go .hero-meta { animation: rise .8s ease .75s both; }
    }
    @keyframes pop {
      0%   { opacity: 0; transform: translateY(108%) rotate(var(--r)); }
      35%  { opacity: .55; }
      70%  { opacity: 1; transform: translateY(-3%) rotate(calc(var(--r) * -.25)); }
      100% { opacity: 1; transform: none; }
    }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    .hero-copy h1 i { font: 300 .78em 'IBM Plex Mono', monospace; letter-spacing: 0; color: var(--accent); margin: 0 .16em; }
    .hero-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; max-width: min(1000px, 88vw); margin: clamp(12px, 2.4vh, 26px) auto 0; }
    .hero-meta .c { font: 700 clamp(1.15rem, 2.4vw, 1.8rem)/1 'Space Grotesk', sans-serif; letter-spacing: -.02em; }
    .hero-meta .tag { font: 400 12.5px/1.3 'IBM Plex Mono', monospace; letter-spacing: .02em; text-transform: uppercase; }
    .hero-meta .cursor { width: 1px; height: 1.1em; background: var(--ink); margin-left: 3px; }
    .crowd { position: absolute; left: 0; right: 0; bottom: 0; height: var(--Z); z-index: 2; pointer-events: none; }
    .crowd canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1); }
    .crowd canvas.loaded { opacity: 1; }
    #cw-rear { z-index: 1; }
    #cw-front { z-index: 3; }
    .char { position: absolute; z-index: 2; left: 50%; bottom: 12px; transform: translateX(-50%); width: auto; max-width: none;
      height: min(calc(var(--Z) * .8), 365px); user-select: none; -webkit-user-drag: none; pointer-events: none; 
      opacity: 0; transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1); }
    @media (max-width: 600px) {
      .hero2 { --Z: min(44vh, 360px); min-height: 600px; }
      .char { height: min(calc(var(--Z) * .8), 310px); }
      .hero-meta .tag { font-size: 10.5px; }
      .hero-copy h1 { font-size: clamp(2.4rem, 14.5vw, 4.2rem); }
    }
    #intro { padding: 72px 0 56px; }
    .intro-title { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(2.8rem, 8vw, 4.6rem); line-height: .96; letter-spacing: -.035em; margin-bottom: 16px; }
    .intro-role { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 1.25rem; line-height: 1.25; margin-bottom: 18px; }

    /* ---------- CLOSING QUOTE ---------- */
    .closing {
      padding: 56px 0 64px;
      border-top: 1px solid var(--line);
    }

    .footer-quote {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.15rem;
      font-weight: 500;
      max-width: 46ch;
      color: var(--ink);
    }

    /* ---------- HALFTONE FOOTER ----------
       Palette is taken from the page: the dark of the terminal block (#14171A),
       its cream text (#EDEAE0) for dots at rest, and its mint (#7FBFA8) as the
       colour dots warm toward when pushed. */
    .hwf-root {
      --hwf-bg: #14171A;
      --hwf-ink: #EDEAE0;
      --hwf-warm: #7FBFA8;
      --hwf-mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
      position: relative;
      width: 100%;
      height: clamp(460px, 44vw, 720px);
      overflow: hidden;
      isolation: isolate;
      background: var(--hwf-bg);
      color: var(--hwf-ink);
      -webkit-font-smoothing: antialiased;
    }

    .hwf-root canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      max-width: none;
    }

    .hwf-top {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr));
      gap: 32px;
      padding: clamp(22px, 3.4vw, 40px) clamp(20px, 3.4vw, 44px) 0;
      font-family: var(--hwf-mono);
      font-size: 10.5px;
      letter-spacing: .18em;
      text-transform: uppercase;
      line-height: 1.75;
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .hwf-brand strong {
      display: block;
      font-weight: 500;
      word-break: normal;
    }

    .hwf-brand span {
      opacity: .45;
      word-break: normal;
    }

    .hwf-col h3 {
      margin: 0 0 8px 0;
      font: inherit;
      opacity: .4;
      font-weight: 500;
    }

    .hwf-col ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .hwf-col li {
      margin-bottom: 4px;
    }

    .hwf-col a,
    .hwf-up {
      color: inherit;
      text-decoration: none;
      opacity: .78;
      border: 0;
      padding: 0;
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      cursor: pointer;
      background-color: transparent;
      background-image: linear-gradient(currentColor, currentColor);
      background-size: 0% 1px;
      background-repeat: no-repeat;
      background-position: 0 100%;
      transition: opacity .25s ease, background-size .35s cubic-bezier(.2, .7, .1, 1);
      display: inline-block;
      max-width: 100%;
      overflow-wrap: break-word;
      word-break: break-all;
    }

    .hwf-col a:hover,
    .hwf-up:hover {
      opacity: 1;
      background-size: 100% 1px;
    }

    .hwf-col a:focus-visible,
    .hwf-up:focus-visible {
      outline: 1px solid currentColor;
      outline-offset: 3px;
      opacity: 1;
    }

    .hwf-rule {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 16px;
      margin: clamp(18px, 2.6vw, 30px) clamp(20px, 3.4vw, 44px) 0;
      padding-top: 12px;
      border-top: 0.5px solid color-mix(in srgb, var(--hwf-ink) 16%, transparent);
      font-family: var(--hwf-mono);
      font-size: 10.5px;
      letter-spacing: .18em;
      text-transform: uppercase;
      flex-wrap: wrap;
    }
    
    @media (max-width: 520px) {
      .hwf-rule {
        justify-content: center;
        font-size: 9.5px;
      }
    }

    .hwf-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    @media (max-width: 720px) {
      .hwf-root {
        height: 400px;
      }

      .hwf-top {
        grid-template-columns: 1fr;
        row-gap: 24px;
        gap: 24px;
        font-size: 10px;
      }

      .hwf-brand {
        padding-bottom: 8px;
        border-bottom: 0.5px solid color-mix(in srgb, var(--hwf-ink) 12%, transparent);
      }
      
      .hwf-col {
        min-width: 0;
      }
    }

    @media (max-width: 520px) {
      .hwf-top {
        font-size: 10px;
        gap: 20px;
      }
      
      .hwf-col a {
        word-break: break-all;
        font-size: 9.5px;
      }
    }

    /* ---------- MOBILE ---------- */
    body { overflow-x: clip; }
    @media (max-width: 720px) {
      .hwf-root { height: 380px; }
      .hwf-top { line-height: 2.1; }
    }
    @media (max-width: 480px) {
      :root { --pad: 20px; }
      .hero { padding: 56px 0 48px; }
      section { padding: 44px 0; }
      .lede { font-size: 1rem; }
      .terminal { font-size: 12px; padding: 12px 14px; }
      .links a { padding: 10px 14px; }
      .card { padding: 16px; }
      .closing { padding: 44px 0 48px; }
      .footer-quote { font-size: 1.05rem; }
    }

    /* ---------- REVEAL ---------- */
    .reveal {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity .5s ease, transform .5s ease;
    }

    .reveal.in {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .cursor {
        animation: none;
      }

      .hwf-col a,
      .hwf-up {
        transition: none;
      }
    }

    /* ================= HERO: bigger + bolder ================= */
    .hero2 { height: 100vh; height: 100svh; min-height: 640px; }
    .hero-copy { top: clamp(72px, 11vh, 130px); }
    .hero-copy h1 {
      font-size: clamp(2.6rem, min(11.5vw, 16vh), 10rem);
      font-weight: 700;
      line-height: .86;
      letter-spacing: -.05em;
      -webkit-text-stroke: .025em var(--ink);
    }
    .hero-copy h1 i { font-weight: 500; font-size: .8em; -webkit-text-stroke: .03em var(--accent); }
    .hero-meta { max-width: min(1500px, 94vw); margin-top: clamp(10px, 2vh, 24px); }
    .hero-meta .c { font-size: clamp(1.8rem, 4vw, 3.4rem); font-weight: 700; letter-spacing: -.03em; }
    .hero-meta .tag { font: 500 clamp(.8rem, 1.6vw, 1.4rem)/1.2 'Space Grotesk', sans-serif; letter-spacing: -.01em; }
    @media (max-width: 600px) {
      .hero-copy h1 { font-size: clamp(2.4rem, 13vw, 4.2rem); }
      .hero-meta .tag { font-size: .8rem; }
    }

    /* ================= PILL NAVBAR ================= */
    .pill {
      position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 200;
      width: min(228px, calc(100vw - 32px));
      display: flex; align-items: center; justify-content: space-between;
      padding: 5px 5px 5px 18px;
      background: #131313; color: #F6F5F1; border-radius: 14px;
      box-shadow: 0 10px 30px -12px rgba(0,0,0,.45), inset 0 0 0 1px rgba(255,255,255,.06);
    }
    .pill-brand { font: 700 1rem/1 'Space Grotesk', sans-serif; letter-spacing: -.02em; color: #fff; text-decoration: none; }
    .pill-btn {
      all: unset; box-sizing: border-box; position: relative; width: 40px; height: 32px;
      display: grid; place-items: center; border-radius: 8px; background: #F6F5F1; cursor: pointer;
      transition: background .2s ease;
    }
    .pill-btn:hover { background: #7FBFA8; }
    .pill-btn:focus-visible { outline: 2px solid #7FBFA8; outline-offset: 3px; }
    .dots { display: flex; gap: 3px; transition: transform .5s cubic-bezier(.65,.01,.05,.99), opacity .25s ease; }
    .dots i { width: 4px; height: 4px; border-radius: 50%; background: #131313; }
    .x { position: absolute; width: 14px; height: 14px; opacity: 0; transform: rotate(-90deg);
      transition: transform .5s cubic-bezier(.65,.01,.05,.99), opacity .25s ease; }
    .x::before, .x::after { content: ""; position: absolute; left: 0; top: 50%; width: 100%; height: 2px; margin-top: -1px; background: #131313; border-radius: 2px; }
    .x::before { transform: rotate(45deg); }
    .x::after { transform: rotate(-45deg); }
    .pill-btn[aria-expanded="true"] .dots { opacity: 0; transform: rotate(90deg); }
    .pill-btn[aria-expanded="true"] .x { opacity: 1; transform: none; }

    /* ================= SIDE MENU ================= */
    .side { position: fixed; inset: 0; z-index: 150; visibility: hidden; transition: visibility 0s .7s; }
    .side.open { visibility: visible; transition-delay: 0s; }
    .side-overlay { position: absolute; inset: 0; background: rgba(20,23,26,.45); opacity: 0; transition: opacity .4s ease; }
    .side.open .side-overlay { opacity: 1; }
    .side-panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(560px, 100vw); overflow: hidden; color: #F6F5F1; }
    .side-layer { position: absolute; inset: 0; transform: translateX(101%); transition: transform .45s cubic-bezier(.65,.01,.05,.99); }
    .side-layer.l1 { background: #7FBFA8; }
    .side-layer.l2 { background: #2F5D50; }
    .side-layer.l3 { background: #14171A; }
    .side.open .side-layer { transform: none; transition-duration: .575s; }
    .side.open .l2 { transition-delay: .12s; }
    .side.open .l3 { transition-delay: .24s; }
    .side-body { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; padding: 104px 44px 32px; }
    .side-list { list-style: none; flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 6px; }
    .side-list li { overflow: hidden; padding: .02em 0; }
    .side-list a {
      display: flex; align-items: baseline; gap: 16px; color: #F6F5F1; text-decoration: none;
      transform: translateY(140%) rotate(10deg); transform-origin: 0 100%; transition: transform .3s ease;
    }
    .side.open .side-list a { transform: none; transition: transform .7s cubic-bezier(.65,.01,.05,.99) calc(.35s + var(--i) * .05s); }
    .num { font: 500 12px 'IBM Plex Mono', monospace; letter-spacing: .06em; color: #7FBFA8; }
    .side-foot {
      display: flex; flex-wrap: wrap; gap: 22px; font: 500 12px 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase;
      opacity: 0; transition: opacity .2s ease;
    }
    .side.open .side-foot { opacity: .85; transition: opacity .5s ease .8s; }
    .side-foot a { color: inherit; text-decoration: none; }
    .side-foot a:hover { text-decoration: underline; text-underline-offset: 4px; }

    /* ================= TEXT-ROLL HOVER ================= */
    .roll {
      position: relative; display: block; overflow: hidden; padding-bottom: .06em;
      font: 700 clamp(2.6rem, 7vw, 4.2rem)/.92 'Space Grotesk', sans-serif; letter-spacing: -.035em; text-transform: uppercase;
    }
    .roll span span { display: inline-block; transition: transform .6s ease-in-out; transition-delay: var(--d, 0s); }
    .roll-b { position: absolute; inset: 0; color: #7FBFA8; }
    .roll-b span { transform: translateY(100%); }
    .side-list a:hover .roll-a span, .side-list a:focus-visible .roll-a span { transform: translateY(-100%); }
    .side-list a:hover .roll-b span, .side-list a:focus-visible .roll-b span { transform: none; }
    .side-list a:focus-visible { outline: 2px solid #7FBFA8; outline-offset: 4px; }

    @media (max-width: 480px) { .side-body { padding: 96px 28px 28px; } }
    @media (prefers-reduced-motion: reduce) {
      .side *, .side, .dots, .x { transition: none !important; }
      .side-list a { transform: none; }
    }
  
    /* ================= EXPERIENCE TIMELINE ================= */
    #experience { --W: min(1120px, calc(100vw - 2 * var(--pad))); width: var(--W); margin-left: calc(50% - var(--W) / 2); border-top: 0; padding-top: 64px; }
    .tl-note { font-size: 13px; color: var(--muted); max-width: 24ch; margin-top: 16px; line-height: 1.45; }
    .tl { position: relative; margin-top: 48px; }
    .tl-svg { position: absolute; left: 0; top: 0; overflow: visible; pointer-events: none; }
    .tl-svg path { stroke: var(--ink); stroke-width: 1.4; stroke-dashoffset: var(--L, 0); }
    .tl.go .tl-svg path { stroke-dashoffset: 0; transition: stroke-dashoffset 1.3s linear; }
    .tl-node .ring { fill: var(--bg); stroke: var(--ink); stroke-width: 1.4; }
    .tl-node .dot { fill: var(--ink); }
    .tl-node.cur .ring { fill: var(--ink); }
    .tl-node.cur .dot { fill: var(--bg); }
    .tl-node.up .ring { stroke-dasharray: 3 3; }
    .tl-pop { opacity: 0; transform: scale(0); transform-box: fill-box; transform-origin: center; }
    .tl.go .tl-pop { animation: tlpop .4s cubic-bezier(.34, 1.56, .64, 1) var(--d, 0s) both; }
    @keyframes tlpop { from { opacity: 0; transform: scale(0); } to { opacity: 1; transform: scale(1); } }
    .tl-cols { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; padding-top: 70px; }
    .tl-item:nth-child(even) { margin-top: 56px; }
    .tl-item { opacity: 0; transform: translateY(14px); transition: opacity .45s ease, transform .45s ease; transition-delay: var(--d, 0s); }
    .tl.go .tl-item { opacity: 1; transform: none; }
    .tl-tag { display: inline-block; font: 500 11.5px/1 'Space Grotesk', sans-serif; background: #14171A; color: #F6F5F1; border-radius: 4px; padding: 6px 9px; margin-bottom: 10px; }
    .tl-item.up .tl-tag { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
    .tl-date { font: 400 12.5px 'IBM Plex Mono', monospace; color: var(--muted); margin-bottom: 12px; }
    .tl-item h3 { font: 600 clamp(1.35rem, 2.1vw, 1.8rem)/1.08 'Space Grotesk', sans-serif; letter-spacing: -.02em; margin-bottom: 14px; }
    .tl-co { font: 500 1rem/1.3 'Space Grotesk', sans-serif; }
    .tl-loc { font-size: 12.5px; color: var(--muted); }
    .tl-desc { font-size: .9rem; line-height: 1.6; color: #4a4a44; margin-top: 12px; }
    .tl-stack { font: 400 11px/1.5 'IBM Plex Mono', monospace; color: var(--muted); margin-top: 12px; }
    @media (max-width: 860px) {
      #experience .work-top { flex-direction: column; gap: 0; }
      .tl-note { max-width: 34ch; }
      .tl { margin-top: 36px; }
      .tl-svg { display: none; }
      .tl-cols { grid-template-columns: 1fr; gap: 0; padding-top: 0; margin-left: 9px; border-left: 1.5px solid var(--ink); }
      .tl-item:nth-child(even) { margin-top: 0; }
      .tl-item { position: relative; padding: 0 0 38px 26px; }
      .tl-item::before { content: ""; position: absolute; left: -8.5px; top: 2px; width: 15px; height: 15px; border-radius: 50%; background: var(--bg); box-shadow: inset 0 0 0 1.5px var(--ink); }
      .tl-item.cur::before { background: var(--ink); }
    }
    @media (prefers-reduced-motion: reduce) {
      .tl-item { opacity: 1; transform: none; transition: none; }
      .tl-svg path { stroke-dashoffset: 0 !important; transition: none !important; }
      .tl-pop { opacity: 1; transform: none; animation: none !important; }
    }

    /* ================= SECTION SNAP SCROLL ================= */
    html { scroll-padding-top: 0; scroll-snap-type: y mandatory; }
    .hero2, #intro, #stack, #experience, #work, #beyond, .closing { scroll-snap-align: start; scroll-snap-stop: always; }
    .hwf-root { scroll-snap-align: end; }
    @media (min-width: 861px) {
      #intro, #stack, #experience, #work, #beyond {
        min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; justify-content: center;
        padding-top: 96px; padding-bottom: 64px;
      }
      #intro { align-items: flex-start; }
    }
    @media (max-width: 860px) { html { scroll-snap-type: y proximity; } }
    @media (prefers-reduced-motion: reduce) { html { scroll-snap-type: none; } }
  </style>
</head>

<body>

  <!-- Global glyph background -->
  <canvas id="glyph" aria-hidden="true"></canvas>

  <div class="pill">
    <a class="pill-brand" href="#top">Satva</a>
    <button class="pill-btn" id="menubtn" type="button" aria-expanded="false" aria-controls="sidemenu" aria-label="Open menu">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="x"></span>
    </button>
  </div>

  <div class="side" id="sidemenu" aria-hidden="true">
    <div class="side-overlay" id="sideoverlay"></div>
    <div class="side-panel">
      <div class="side-layer l1"></div>
      <div class="side-layer l2"></div>
      <div class="side-layer l3"></div>
      <div class="side-body">
        <ul class="side-list">
          <li><a href="#top" style="--i:0"><span class="num">01</span><span class="roll" data-roll>Home</span></a></li>
          <li><a href="#stack" style="--i:1"><span class="num">02</span><span class="roll" data-roll>Tech Stack</span></a></li>
          <li><a href="#experience" style="--i:2"><span class="num">03</span><span class="roll" data-roll>Experience</span></a></li>
          <li><a href="#work" style="--i:3"><span class="num">04</span><span class="roll" data-roll>Work</span></a></li>
          <li><a href="#beyond" style="--i:4"><span class="num">05</span><span class="roll" data-roll>Beyond</span></a></li>
        </ul>
        <div class="side-foot">
          <a href="mailto:satvalite@gmail.com">Email</a>
          <a href="https://github.com/stva01" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/satva-shah/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>

  <section class="hero2" id="top" aria-label="Introduction">
      <div class="hero-copy go" id="herocopy">

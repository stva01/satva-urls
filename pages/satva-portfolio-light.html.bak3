          items: [["Built with", "Flutter and Dart"], ["Context", "Companion to the multilingual ingredient translation work"], ["Source", "Open the repository", GH + "Khao-The-App"]] },
        { label: "claude-token-counter", cap: "JavaScript", href: GH + "claude-token-counter", a: ["forest", 21], b: ["mist", 9], tab: "#2F5D50", sub: "Token usage utility",

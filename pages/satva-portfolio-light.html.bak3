        { label: "DBT_AirBnb", cap: "dbt · PowerShell", href: GH + "DBT_AirBnb", a: ["mist", 14], b: ["forest", 6], tab: "#7FBFA8", sub: "Data modeling project",
          about: "A data modeling project applying dbt to Airbnb listings data.",
          stack: "dbt / PowerShell", h: "At a glance", vis: ["dbt", "Models", "Listings"],
          items: [["Built with", "dbt and PowerShell"], ["Data", "Airbnb listings"], ["Source", "Open the repository", GH + "DBT_AirBnb"]] }
      ];

      var row = document.getElementById("folders"), wrap = document.getElementById("pdwrap"), pane = document.getElementById("pdpane");
      if (!row || !wrap || !pane) return;
      var cur = -1, W = [[78, 56, 70, 40, 62], [60, 74, 44, 66, 52], [70, 48, 64, 58, 36]];
      var BAR = '<span class="sh-bar"><i></i><i></i><i></i></span>';

      function sheets(p, i) {
        var w = W[i % 3], l = BAR + '<span class="sh-l h"></span>';
        w.slice().reverse().forEach(function (x) { l += '<span class="sh-l" style="width:' + x + '%"></span>'; });
        return '<div class="fd-sheet fd-a">' + art(p.b[0], p.b[1], 200, 150) + BAR + '</div><div class="fd-sheet fd-b">' + l + '</div>';
      }

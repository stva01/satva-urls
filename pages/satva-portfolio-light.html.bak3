  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>

  <script>window.SATVA_ASSETS={crowd:"assets/crowd.webp",rects:[[3, 28, 287, 329], [290, 31, 276, 326], [581, 33, 288, 327], [887, 49, 271, 308], [1158, 33, 282, 325], [2, 384, 278, 334], [295, 387, 284, 331], [579, 386, 290, 332], [869, 400, 289, 318], [1158, 387, 290, 331], [0, 761, 284, 318], [292, 747, 287, 332], [579, 762, 290, 317], [869, 761, 287, 318], [1173, 761, 268, 318]]};</script>
  <script>
(function () {
  var hero = document.getElementById('top');
  if (!hero) return;
  var A = window.SATVA_ASSETS || {};
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var inView = true, tabOn = !document.hidden, paused = false, raf = 0, prev = 0, gT = 0, cT = 0, glyph = null, crowd = null;

  /* ================= glyph background (WebGL, ported from the React component) ================= */
  var CHARS = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  var MW = 12, TR = 12, TL = 700, WL = 4, WGAP = 0.3, WSPEED = 560, WSLOW = 0.66, WEDGE = 10, WTAIL = 30, DRIFT = [-30, 12], ADECAY = 900;
  var VERT = 'attribute vec2 position;void main(){gl_Position=vec4(position,0.0,1.0);}';
  var FRAG = `
precision highp float;
uniform sampler2D atlas; uniform vec2 size; uniform vec2 cell; uniform float dpr; uniform float count; uniform float time;
uniform float rest; uniform float haze; uniform float hoverInk; uniform float activity; uniform vec2 drift;
uniform vec3 color; uniform vec3 accent; uniform vec4 waves[${MW * 2}]; uniform vec4 trail[${TR}];
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float smoothNoise(vec2 p){vec2 i=floor(p);vec2 f=fract(p);vec2 u=f*f*(3.0-2.0*f);
  return mix(mix(hash(i),hash(i+vec2(1.0,0.0)),u.x),mix(hash(i+vec2(0.0,1.0)),hash(i+vec2(1.0,1.0)),u.x),u.y);}
float outline(float kind,float angle,float phase){
  if(kind<0.5)return 1.0;
  if(kind<1.5){float s=sin(angle);float c=cos(angle);return (2.0-2.0*s+s*sqrt(abs(c))/(s+1.4))*0.42;}
  return 1.0+0.14*sin(3.0*angle+phase)+0.08*sin(5.0*angle-phase*1.3);}
void main(){
  vec2 pixel=vec2(gl_FragCoord.x,size.y-gl_FragCoord.y);
  vec2 index=floor(pixel/cell);
  vec2 point=(index+0.5)*cell/dpr;
  float ring=0.0;
  for(int i=0;i<${MW};i++){
    vec4 a=waves[i*2]; vec4 b=waves[i*2+1];
    if(a.w<=0.0)continue;
    vec2 v=point-a.xy;
    float angle=atan(-v.y,v.x);
    float shape=mix(1.0,outline(b.x,angle,b.z),b.y);
    shape*=1.0+0.07*sin(3.0*angle+b.z+b.w)+0.05*sin(5.0*angle-b.z*1.7-b.w*1.3)+0.03*sin(9.0*angle+b.w*2.1);
    float d=length(v)-a.z*shape;
    float k=d>0.0?d/${WEDGE.toFixed(1)}:d/${WTAIL.toFixed(1)};
    ring=max(ring,exp(-k*k)*a.w);
  }
  float hover=0.0;
  for(int i=0;i<${TR};i++){
    vec4 t=trail[i];
    if(t.w<=0.0)continue;
    vec2 v=point-t.xy;
    hover+=t.w*exp(-dot(v,v)/(2.0*t.z*t.z));
  }
  hover=min(hover,1.0);
  mat2 turn=mat2(0.82,0.57,-0.57,0.82);
  vec2 q=turn*(point-drift);
  float blob=smoothNoise(vec2(q.x/140.0,q.y/80.0)+vec2(time*0.04,0.0))*0.62+smoothNoise(vec2(q.x/62.0,q.y/36.0)+vec2(3.7,time*0.06))*0.38;
  float grain=smoothNoise(vec2(q.x/30.0,q.y/14.0)+vec2(time*0.2,7.3));
  float cloud=blob*(0.82+0.24*grain);
  float mask=pow(smoothstep(0.47-0.2*activity,0.84,cloud),2.6);
  float seed=hash(index);
  float epoch=floor(time*0.08*(0.4+seed)+seed*97.0);
  float character=floor(hash(index+epoch*0.137)*count);
  vec2 local=fract(pixel/cell);
  float ink=pow(texture2D(atlas,vec2((character+local.x)/count,local.y)).a,1.7);
  float grey=ink*clamp(rest+haze*mask*(1.0+0.3*activity)+hoverInk*hover*(0.6+0.4*mask),0.0,1.0);
  float blue=ink*ring*0.72;
  float alpha=grey+blue-grey*blue;
  vec3 tint=color*grey*(1.0-blue)+accent*blue;
  gl_FragColor=vec4(tint,alpha);
}`;

  function makeGlyph(cv) {
    var gl = cv.getContext('webgl', { premultipliedAlpha: true, preserveDrawingBuffer: true, antialias: false });
    if (!gl) return null;
    function sh(t, s) { var o = gl.createShader(t); gl.shaderSource(o, s); gl.compileShader(o); return gl.getShaderParameter(o, gl.COMPILE_STATUS) ? o : null; }
    var vs = sh(gl.VERTEX_SHADER, VERT), fs = sh(gl.FRAGMENT_SHADER, FRAG), pr = gl.createProgram();
    if (!vs || !fs) return null;
    gl.attachShader(pr, vs); gl.attachShader(pr, fs); gl.linkProgram(pr);
    if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) return null;
    gl.useProgram(pr);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    var pos = gl.getAttribLocation(pr, 'position');
    gl.enableVertexAttribArray(pos); gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);
    gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
    [[gl.TEXTURE_MIN_FILTER, gl.LINEAR], [gl.TEXTURE_MAG_FILTER, gl.LINEAR], [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE], [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE]]
      .forEach(function (p) { gl.texParameteri(gl.TEXTURE_2D, p[0], p[1]); });
    var U = {};
    ['atlas', 'size', 'cell', 'dpr', 'count', 'time', 'rest', 'haze', 'hoverInk', 'activity', 'drift', 'color', 'accent', 'waves', 'trail']
      .forEach(function (n) { U[n] = gl.getUniformLocation(pr, n); });
    gl.uniform1i(U.atlas, 0); gl.uniform1f(U.count, CHARS.length); gl.uniform1f(U.rest, 0);
    gl.uniform1f(U.haze, 0.1); gl.uniform1f(U.hoverInk, 0.35);
    gl.uniform3f(U.color, 0.09, 0.09, 0.09);          // ink
    gl.uniform3f(U.accent, 47 / 255, 93 / 255, 80 / 255); // page accent green

    var w = 0, h = 0, dpr = 1, cell = [7, 13], FS = 11, waves = [], trail = [], act = { v: 0, at: 0 };
    var wv = new Float32Array(MW * 8), tv = new Float32Array(TR * 4);

    function resize() {
      w = window.innerWidth; h = window.innerHeight; dpr = Math.max(1, Math.min(devicePixelRatio || 1, 2));
      cv.width = Math.max(1, Math.round(w * dpr)); cv.height = Math.max(1, Math.round(h * dpr));
      var font = FS * dpr + 'px Menlo, ui-monospace, SFMono-Regular, Consolas, monospace';
      var m = document.createElement('canvas').getContext('2d'); m.font = font;
      cell = [Math.round(m.measureText('0').width), Math.round(FS * 1.25 * dpr)];
      var at = document.createElement('canvas'); at.width = Math.ceil(cell[0] * CHARS.length); at.height = Math.ceil(cell[1]);
      var c = at.getContext('2d'); c.font = font; c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillStyle = '#fff';
      for (var i = 0; i < CHARS.length; i++) c.fillText(CHARS[i], (i + 0.5) * cell[0], cell[1] / 2);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, at);
    }
    function decay(t) { return act.v * Math.exp(-Math.max(0, t - act.at) / ADECAY); }
    return {
      resize: resize,
      move: function (x, y) {
        var last = trail[trail.length - 1], d = last ? Math.hypot(x - last.x, y - last.y) : 0;
        act = { v: Math.min(1, decay(gT) + d / 600), at: gT };
        if (last && d < 18) return;
        trail = trail.filter(function (p) { return gT - p.t < TL; }).slice(1 - TR);
        trail.push({ x: x, y: y, t: gT });
      },
      spawn: function (x, y) {
        var kind = 1 + Math.floor(Math.random() * 2), phase = Math.random() * 6.2832;
        [[0, 1], [WGAP, 0.55]].forEach(function (p) { waves.push({ x: x, y: y, kind: kind, phase: phase, st: p[1], t0: gT, dl: p[0] }); });
        waves = waves.slice(-MW);
      },
      draw: function (t) {
        if (!w) return;
        var s = t / 1000;
        waves = waves.filter(function (o) { return (t - o.t0) / 1000 - o.dl < WL; });
        wv.fill(0);
        waves.forEach(function (o, i) {
          var age = (t - o.t0) / 1000 - o.dl; if (age <= 0) return;
          var rad = WSPEED * age / (1 + WSLOW * age);
          var fade = Math.min(1, age / 0.05) * Math.exp(-Math.max(0, age - 0.4) / 1.3) * Math.min(1, (WL - age) / 0.5);
          wv.set([o.x, o.y, rad, fade * o.st, o.kind, 0.12 + 0.5 * Math.min(1, age / 2.2), o.phase, age * 3], i * 8);
        });
        tv.fill(0);
        trail.forEach(function (p, i) {
          var age = (t - p.t) / TL; if (age < 0 || age >= 1) return;
          tv.set([p.x, p.y, 40 + 25 * age, 0.3 * (1 - age) * (1 - age)], i * 4);
        });
        gl.viewport(0, 0, cv.width, cv.height);
        gl.uniform2f(U.size, cv.width, cv.height); gl.uniform2f(U.cell, cell[0], cell[1]); gl.uniform1f(U.dpr, dpr);
        gl.uniform1f(U.time, s); gl.uniform1f(U.activity, decay(t)); gl.uniform2f(U.drift, DRIFT[0] * s, DRIFT[1] * s);
        gl.uniform4fv(U.waves, wv); gl.uniform4fv(U.trail, tv);
        gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT); gl.drawArrays(gl.TRIANGLES, 0, 3);
      }
    };
  }

  /* ================= crowd (two canvases, character sits between them) ================= */
  function makeCrowd() {
    var zone = hero.querySelector('.crowd'), rc = document.getElementById('cw-rear'), fc = document.getElementById('cw-front');
    var rx = rc.getContext('2d'), fx = fc.getContext('2d'), img = new Image(), R = A.rects || [], walkers = [], W = 0, Z = 0, dpr = 1, ready = false, lastW = -1, M = 240;
    function rnd(a, b) { return a + Math.random() * (b - a); }
    function order(n) {                                  // sprite order with no identical neighbours
      var out = [], last = -1;
      while (out.length < n) {
        var p = R.map(function (_, i) { return i; }).sort(function () { return Math.random() - 0.5; });
        if (p[0] === last) p.push(p.shift());
        out = out.concat(p); last = out[out.length - 1];
      }
      out = out.slice(0, n); if (n > 1 && out[0] === out[n - 1]) out.push(out.shift());
      return out;
    }
    function build() {
      var small = W < 600, nr = small ? 9 : Math.round(W / 46), nf = small ? 4 : Math.max(4, Math.round(W / 125));
      var sr = order(nr), sf = order(nf); walkers = [];
      for (var i = 0; i < nr; i++) walkers.push({ s: sr[i], dir: 1, ph: (i + rnd(-0.3, 0.3)) / nr, dur: rnd(12, 16), h: Z * rnd(0.32, 0.38), base: Z * 0.7, amp: rnd(2, 7), bp: Math.random(), bf: rnd(1.8, 2.2), front: false });
      for (i = 0; i < nf; i++) walkers.push({ s: sf[i], dir: -1, ph: (i + rnd(-0.35, 0.35)) / nf, dur: rnd(10, 13), h: Z * rnd(0.42, 0.48), base: Z * 1.06, amp: rnd(3, 9), bp: Math.random(), bf: rnd(1.8, 2.2), front: true });
      walkers.sort(function (a, b) { return a.h - b.h; });
    }
    function size() {
      W = zone.clientWidth; Z = zone.clientHeight; dpr = Math.max(1, Math.min(devicePixelRatio || 1, 2));
      [rc, fc].forEach(function (c) { c.width = Math.round(W * dpr); c.height = Math.round(Z * dpr); });
      rx.setTransform(dpr, 0, 0, dpr, 0, 0); fx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (Math.abs(W - lastW) > 2) { lastW = W; build(); }
    }
    function draw(t) {
      if (!ready || !W) return;
      var s = t / 1000, span = W + 2 * M;
      rx.clearRect(0, 0, W, Z); fx.clearRect(0, 0, W, Z);
      walkers.forEach(function (k) {
        var u = (((k.ph + k.dir * s / k.dur) % 1) + 1) % 1, x = u * span - M, bob = Math.sin((s * k.bf + k.bp) * 6.2832) * k.amp, r = R[k.s], w = k.h * r[2] / r[3];
        (k.front ? fx : rx).drawImage(img, r[0], r[1], r[2], r[3], x - w / 2, k.base - k.h + bob, w, k.h);
      });
    }
    img.onload = function () { 
      ready = true; 
      size(); 
      draw(cT); 
      img.style.opacity = '0'; 
      setTimeout(function() { 
        img.style.transition = 'opacity 0.8s ease-in-out'; 
        img.style.opacity = '1'; 
        // Fade in canvases after crowd image loads
        rc.classList.add('loaded');
        fc.classList.add('loaded');
      }, 150); 
    };
    img.src = A.crowd || '';
    new ResizeObserver(function () { size(); draw(cT); }).observe(zone);
    return { draw: draw };
  }

  /* ================= wiring ================= */
  glyph = makeGlyph(document.getElementById('glyph'));
  if (glyph) { 
    glyph.resize(); 
    window.addEventListener('resize', function() { glyph.resize(); glyph.draw(gT); });
  }
  crowd = makeCrowd();

  /* ================= character image fade-in ================= */
  var charImg = document.getElementById('char');
  if (charImg) {
    if (charImg.complete && charImg.naturalHeight !== 0) {
      setTimeout(function() { charImg.style.opacity = '1'; }, 150);
    } else {
      charImg.addEventListener('load', function() {
        setTimeout(function() { charImg.style.opacity = '1'; }, 150);
      });
    }
  }

  function local(e) { return [e.clientX, e.clientY]; }
  if (glyph && !reduce) {
    document.body.addEventListener('pointermove', function (e) { var p = local(e); glyph.move(p[0], p[1]); });
    document.body.addEventListener('pointerdown', function (e) { if (e.target.closest('a,button,input,textarea')) return; var p = local(e); glyph.spawn(p[0], p[1]); });
  }

  var copy = document.getElementById('herocopy'), seen = true;
  if (copy) new IntersectionObserver(function (es) {
    var v = es[0].isIntersecting;
    if (v && !seen) { copy.classList.remove('go'); void copy.offsetWidth; copy.classList.add('go'); }
    seen = v;
  }, { threshold: 0.35 }).observe(copy);

  function tick(now) {
    raf = 0;
    var dt = Math.min(now - prev, 64); prev = now;
    var runCrowd = !reduce && inView && tabOn;
    var runGlyph = !reduce && tabOn;
    if (runCrowd) { gT += dt; if (!paused) { cT += dt; crowd.draw(cT); } }
    if (runGlyph && glyph) { gT += dt; glyph.draw(gT); }
    if (runGlyph || runCrowd) raf = requestAnimationFrame(tick);
  }
  function kick() { if (!raf && !reduce && tabOn) { prev = performance.now(); raf = requestAnimationFrame(tick); } }

  new IntersectionObserver(function (es) { inView = es[0].isIntersecting; if (inView) kick(); }).observe(hero);
  document.addEventListener('visibilitychange', function () { tabOn = !document.hidden; if (tabOn) kick(); });

  if (glyph) glyph.draw(0);
  kick();
})();

  </script>

  <!-- Project folders -->
  <script>
    (function () {
      // ---- generated artwork (domain-warped noise, shaded as a liquid surface) ----
      var ART = {
        forest: { st: 0, c: ["#0c1210", "#173a31", "#2F5D50", "#14171A", "#7FBFA8", "#cfe6da", "#F6F5F1"], sc: .7, wp: 3.4, an: 2.1, gl: .5, vn: .5 },
        mist: { st: 1, c: ["#F6F5F1", "#E4EBE7", "#b9d3c8", "#7FBFA8", "#2F5D50", "#14171A"], sc: .7, wp: 1.6, an: .35, gl: .25, vn: 0 },
        moss: { st: 0, c: ["#14171A", "#2F5D50", "#EDEAE0", "#7FBFA8", "#173a31", "#F6F5F1"], sc: .75, wp: 3.6, an: .8, gl: .5, vn: .5 }
      };
      function rng(seed) { var a = seed >>> 0; return function () { a = (a + 0x6d2b79f5) >>> 0; var t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
      function hex(h) { var n = parseInt(h.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; }
      function fbmOf(seed) {
        var r = rng(seed), perm = new Uint8Array(512), grad = new Float32Array(512), p = [], i;
        for (i = 0; i < 256; i++) p.push(i);
        for (i = 255; i > 0; i--) { var j = Math.floor(r() * (i + 1)), t = p[i]; p[i] = p[j]; p[j] = t; }
        for (i = 0; i < 512; i++) perm[i] = p[i & 255];
        for (i = 0; i < 256; i++) { var a = r() * 6.2832; grad[i * 2] = Math.cos(a); grad[i * 2 + 1] = Math.sin(a); }
        function noise(x, y) {
          var xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi, X = xi & 255, Y = yi & 255;
          var a = perm[X + perm[Y]] * 2, b = perm[X + 1 + perm[Y]] * 2, c = perm[X + perm[Y + 1]] * 2, d = perm[X + 1 + perm[Y + 1]] * 2;
          var d00 = grad[a] * xf + grad[a + 1] * yf, d10 = grad[b] * (xf - 1) + grad[b + 1] * yf, d01 = grad[c] * xf + grad[c + 1] * (yf - 1), d11 = grad[d] * (xf - 1) + grad[d + 1] * (yf - 1);
          var u = xf * xf * xf * (xf * (xf * 6 - 15) + 10), v = yf * yf * yf * (yf * (yf * 6 - 15) + 10);
          return d00 + u * (d10 - d00) + v * (d01 - d00 + u * (d11 - d01 - d10 + d00));
        }
        return function (x, y, o) { var sum = 0, amp = .5; for (var k = 0; k < o; k++) { sum += amp * noise(x, y); var nx = 1.6 * x + 1.2 * y + 7.1; y = -1.2 * x + 1.6 * y + 3.3; x = nx; amp *= .5; } return sum; };
      }
      function job(w, h, rc, seed) {
        var st = rc.c.map(function (c, i) { return { t: i / (rc.c.length - 1), c: hex(c) }; });
        var fbm = fbmOf(seed * 977 + 13), r = rng(seed + 1), ox = r() * 50, oy = r() * 50, ang = rc.an + (r() - .5) * .5, ca = Math.cos(ang), sa = Math.sin(ang), m = Math.min(w, h);
        var gw = Math.ceil(w / 2) + 3, gh = Math.ceil(h / 2) + 3, G = new Float32Array(gw * gh), GQ = new Float32Array(gw * gh), F = new Float32Array(w * h), Q = new Float32Array(w * h), px = new Uint8ClampedArray(w * h * 4), row = 0;
        function field(gy) {
          for (var gx = 0; gx < gw; gx++) {
            var u = ((gx - 1) * 2 - w / 2) / m, v = ((gy - 1) * 2 - h / 2) / m, X = (u * ca - v * sa) * rc.sc, Y = (u * sa + v * ca) * rc.sc;
            if (rc.st) { X *= .14; Y *= 2.2; }
            X += ox; Y += oy;
            var qx = fbm(X, Y, 3), qy = fbm(X + 5.2, Y + 1.3, 3), rx = fbm(X + rc.wp * qx + 1.7, Y + rc.wp * qy + 9.2, 3), ry = fbm(X + rc.wp * qx + 8.3, Y + rc.wp * qy + 2.8, 3);
            G[gy * gw + gx] = fbm(X + rc.wp * rx, Y + rc.wp * ry, 4); GQ[gy * gw + gx] = Math.sqrt(qx * qx + qy * qy);
          }
        }
        function finish() {
          function cr(a, b, c, d) { return (-a + 9 * b + 9 * c - d) / 16; }
          var T = new Float32Array(w * gh), x, y, i;
          for (var g = 0; g < gh; g++) for (x = 0; x < w; x++) { var c = (x >> 1) + 1, o = g * gw; T[g * w + x] = x & 1 ? cr(G[o + c - 1], G[o + c], G[o + c + 1], G[o + c + 2]) : G[o + c]; }
          for (y = 0; y < h; y++) { var c2 = (y >> 1) + 1; for (x = 0; x < w; x++) {
            F[y * w + x] = y & 1 ? cr(T[(c2 - 1) * w + x], T[c2 * w + x], T[(c2 + 1) * w + x], T[(c2 + 2) * w + x]) : T[c2 * w + x];
            var gx = (x >> 1) + 1, q0 = GQ[c2 * gw + gx], qx = x & 1 ? (q0 + GQ[c2 * gw + gx + 1]) / 2 : q0;
            var q1 = y & 1 ? (x & 1 ? (GQ[(c2 + 1) * gw + gx] + GQ[(c2 + 1) * gw + gx + 1]) / 2 : GQ[(c2 + 1) * gw + gx]) : qx; Q[y * w + x] = (qx + q1) / 2; } }
          var sm = [], stride = Math.max(1, Math.floor(F.length / 4096)); for (i = 0; i < F.length; i += stride) sm.push(F[i]);
          sm.sort(function (a, b) { return a - b; });
          var lo = sm[Math.floor(sm.length * .02)], hi = sm[Math.floor(sm.length * .98)], k = 1 / (hi - lo || 1), slope = k * m * .012;
          for (y = 0; y < h; y++) for (x = 0; x < w; x++) {
            i = y * w + x; var t = (F[i] - lo) * k; t = t < 0 ? 0 : t > 1 ? 1 : t;
            var j = 1; while (j < st.length - 1 && st[j].t < t) j++;
            var a = st[j - 1], b = st[j], f = (t - a.t) / (b.t - a.t || 1); f = f < 0 ? 0 : f > 1 ? 1 : f; f = f * f * (3 - 2 * f);
            var gx2 = (F[x < w - 1 ? i + 1 : i] - F[x > 0 ? i - 1 : i]) * slope, gy2 = (F[y < h - 1 ? i + w : i] - F[y > 0 ? i - w : i]) * slope;
            var nd = (.55 * gx2 + .65 * gy2 + .52) / Math.sqrt(gx2 * gx2 + gy2 * gy2 + 1), spec = Math.pow(nd > 0 ? nd : 0, 24) * rc.gl * 255;
            var silk = 1 + .035 * Math.sin(t * 150 + Q[i] * 24), vein = rc.vn * Math.max(0, 1 - Math.abs(Q[i] - .42) * 14) * .6, lit = (.82 + .28 * nd) * silk * (1 - vein);
            for (var ch = 0; ch < 3; ch++) px[i * 4 + ch] = (a.c[ch] + (b.c[ch] - a.c[ch]) * f) * lit + spec; px[i * 4 + 3] = 255;
          }
        }
        return { w: w, h: h, px: px, step: function (n) { if (row >= gh) return true; var e = Math.min(gh, row + n); while (row < e) field(row++); if (row < gh) return false; finish(); return true; } };
      }
      var cache = {}, queue = [], pumping = false;
      function pump() {
        if (pumping) return; pumping = true;
        (function tick() {
          var until = performance.now() + 7;
          while (queue.length && performance.now() < until) {
            var q = queue[0];
            if (q.j.step(4)) { queue.shift(); var c = document.createElement("canvas"); c.width = q.j.w; c.height = q.j.h; c.getContext("2d").putImageData(new ImageData(q.j.px, q.j.w, q.j.h), 0, 0); q.done(c); }
          }
          if (queue.length) requestAnimationFrame(tick); else pumping = false;
        })();
      }
      function paint(n, seed, w, h) {
        var k = [n, seed, w, h].join("|");
        return cache[k] || (cache[k] = new Promise(function (done) { queue.push({ j: job(w, h, ART[n], seed), done: done }); pump(); }));
      }
      function mount(cv) {
        paint(cv.dataset.r, +cv.dataset.s, +cv.dataset.w, +cv.dataset.h).then(function (src) {
          cv.width = src.width; cv.height = src.height; cv.getContext("2d").drawImage(src, 0, 0); cv.setAttribute("data-ready", "");
        });
      }
      function art(r, s, w, h) { return '<canvas class="fd-art" data-r="' + r + '" data-s="' + s + '" data-w="' + w + '" data-h="' + h + '" aria-hidden="true"></canvas>'; }

      // ---- projects ----
      var GH = "https://github.com/stva01/";
      var P = [
        { label: "F1 Pipeline", cap: "Data engineering", href: GH + "ETL_F1", a: ["forest", 3], b: ["mist", 5], tab: "#2F5D50", sub: "Data engineering pipeline",
          about: "A production-grade Medallion architecture on AWS. Post-race data from three sources is extracted into S3, then transformed into cleaned Parquet by PySpark scripts on AWS Glue, with idempotency enforced through manifest files and watermarking.",
          stack: "Python / PySpark / dbt / Snowflake / AWS S3", h: "Architecture walkthrough", vis: ["Bronze", "Silver", "Gold"],
          items: [["Three sources", "CSV, JSON and deeply nested JSON"], ["Extract to S3", "Automatic, after each race"], ["PySpark on AWS Glue", "Cleaned Parquet, no duplicate runs"],
                  ["Snowflake star schema", "Loaded through external S3 stages"], ["dbt models", "Incremental, SCD Type 2, partition clustering"], ["Marts and MCP layer", "Natural-language queries without raw fact tables"]] },
        { label: "VoiceCart", cap: "Multilingual ordering", a: ["mist", 7], b: ["moss", 2], tab: "#7FBFA8", sub: "WhatsApp order assistant",
          about: "A WhatsApp assistant for automated order placement with real-time inventory validation, using OpenAI Whisper, Groq inference and a RAG pipeline with vector embeddings for context-aware replies across regional language variants.",
          stack: "Python / Whisper / Groq / AutoGen", h: "How an order flows", vis: ["Whisper", "Groq", "RAG"],
          items: [["WhatsApp message", "The customer's order request"], ["Whisper", "Speech to text"], ["AutoGen agents on Groq", "Fast inference for the conversation"],
                  ["RAG over embeddings", "Context-aware, regional language variants"], ["Inventory check", "Validated in real time"], ["Reply", "Sub-2 second response times"]] },
        { label: "Khao", cap: "Flutter · Dart", href: GH + "Khao-The-App", a: ["moss", 11], b: ["forest", 4], tab: "#2F5D50", sub: "Food-focused mobile app",
          about: "A food-focused mobile app, built alongside my work on multilingual ingredient translation.",

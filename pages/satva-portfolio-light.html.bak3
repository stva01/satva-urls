          '<div class="pd-main"><h3>' + p.label + '</h3><p class="pd-sub">' + p.sub + '</p>' +
          '<div class="pd-sec"><h4>Inside ' + p.label + '</h4><p>' + p.about + '</p><div class="pd-stack">' + p.stack + '</div>' +
          '<div class="pd-links"><a href="' + p.href + '" target="_blank" rel="noopener">Source &#8599;</a></div></div>' +
          '<div class="pd-sec"><h4>' + p.h + '</h4><ol class="flow">' + items + '</ol></div></div></div>';
      }
      function setActive(i) {
        Array.prototype.forEach.call(row.children, function (el, k) {
